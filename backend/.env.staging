# Staging Environment Configuration
NODE_ENV=staging
PORT=5000

# Database
DATABASE_URL=postgresql://username:password@staging-db-host:5432/smarthealth_staging?schema=public

# JWT Secret
JWT_SECRET=your_staging_jwt_secret

# ML Service
ML_SERVICE_URL=http://staging-ml-service:8000

# Frontend URL
FRONTEND_URL=https://staging.your-domain.com

# Redis for session management
REDIS_URL=redis://staging-redis:6379

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=staging-email@gmail.com
EMAIL_PASSWORD=staging-app-password
EMAIL_FROM=noreply@staging-domain.com

# Proxy Configuration
TRUSTED_PROXY=true
